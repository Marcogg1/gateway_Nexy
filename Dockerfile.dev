# syntax=docker/dockerfile:1.7

# ---- Stage 1: builder ----
# Compiles native Python extensions (dbus-next inside bless, gpiod, ...) into
# a self-contained venv at /opt/venv. The venv is the only artifact carried
# forward, so build tools and -dev headers never reach the runtime image.
FROM python:3.14.2-slim-bookworm AS builder

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends \
        gcc libc6-dev pkg-config \
        libdbus-1-dev libglib2.0-dev

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY vendor/nexyhub-ble-sdk /tmp/nexyhub-ble-sdk
COPY requirements.txt /tmp/requirements.txt

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --prefer-binary \
        /tmp/nexyhub-ble-sdk \
        -r /tmp/requirements.txt \
        debugpy

# ---- Stage 2: runtime ----
# Slim base + only runtime .so libs. The venv from the builder is copied in
# wholesale and put first on PATH so `python` and `pip` resolve to it.
FROM python:3.14.2-slim-bookworm

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends \
        dbus libdbus-1-3 libglib2.0-0 \
        bluez \
        iproute2 \
        openssh-server \
        libgpiod2 \
    && mkdir -p /run/sshd

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY scripts/sshd_config /etc/ssh/sshd_config

ENV SSH_ENABLED=true
ENV SSH_PORT=22

COPY scripts/entrypoint.sh /entrypoint.sh
COPY scripts/docker-entrypoint.d/ /docker-entrypoint.d/
RUN chmod +x /entrypoint.sh /docker-entrypoint.d/*.sh

COPY . /src

RUN mkdir -p /src/logs

EXPOSE 22 8080 5678

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "src/main.py"]
